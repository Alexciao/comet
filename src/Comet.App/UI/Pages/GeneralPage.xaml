<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Comet.App.UI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <InfoBar x:Name="ProblemsBar" Severity="Warning" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />

        <controls:SettingsCard
            x:Name="ActiveCard"
            Header="Comet is on"
            Description="Turn off to pause everything, in every app"
            Glyph="&#xE768;">
            <ToggleSwitch x:Name="ActiveToggle"
                AutomationProperties.Name="Comet is on" OnContent="On" OffContent="Paused" Toggled="OnActiveToggled" />
        </controls:SettingsCard>

        <TextBlock Text="Features" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <controls:SettingsCard Header="Emoji" Description="Type : and a few letters to pick an emoji" Glyph="&#xE76E;">
            <ToggleSwitch x:Name="EmojiToggle"
                AutomationProperties.Name="Emoji" OnContent="On" OffContent="Off" Toggled="OnFeatureToggled" />
        </controls:SettingsCard>
        <controls:SettingsCard x:Name="SnippetsCard" Header="Snippets" Glyph="&#xE8C8;">
            <ToggleSwitch x:Name="SnippetsToggle"
                AutomationProperties.Name="Snippets" OnContent="On" OffContent="Off" Toggled="OnFeatureToggled" />
        </controls:SettingsCard>
        <controls:SettingsCard x:Name="AutoReplaceCard" Header="Auto-replace" Glyph="&#xE8AC;">
            <ToggleSwitch x:Name="AutoReplaceToggle"
                AutomationProperties.Name="Auto-replace" OnContent="On" OffContent="Off" Toggled="OnFeatureToggled" />
        </controls:SettingsCard>

        <TextBlock Text="Typing" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <controls:SettingsCard Header="Trigger character" Description="The character that opens the list" Glyph="&#xE765;">
            <TextBox
                x:Name="TriggerBox"
                AutomationProperties.Name="Trigger character"
                Width="64"
                MaxLength="1"
                TextAlignment="Center"
                FontSize="16"
                IsSpellCheckEnabled="False"
                LostFocus="OnTriggerChanged"
                KeyDown="OnTriggerKeyDown" />
        </controls:SettingsCard>
        <controls:SettingsCard Header="Show the list after" Description="Letters to type after the trigger before the list appears" Glyph="&#xE8E9;">
            <ComboBox x:Name="MinCharsBox"
                AutomationProperties.Name="Show the list after" MinWidth="140" SelectionChanged="OnMinCharsChanged">
                <x:String>1 letter</x:String>
                <x:String>2 letters</x:String>
                <x:String>3 letters</x:String>
                <x:String>4 letters</x:String>
                <x:String>5 letters</x:String>
            </ComboBox>
        </controls:SettingsCard>
        <controls:SettingsCard Header="Default skin tone" Description="Used for emoji that come in different skin tones" Glyph="&#xE790;">
            <ComboBox x:Name="SkinToneBox"
                AutomationProperties.Name="Default skin tone" MinWidth="200" SelectionChanged="OnSkinToneChanged">
                <x:String>✋  Default</x:String>
                <x:String>✋🏻  Light</x:String>
                <x:String>✋🏼  Medium-light</x:String>
                <x:String>✋🏽  Medium</x:String>
                <x:String>✋🏾  Medium-dark</x:String>
                <x:String>✋🏿  Dark</x:String>
            </ComboBox>
        </controls:SettingsCard>
        <controls:SettingsLinkCard x:Name="ExcludedCard" Header="Excluded apps" Glyph="&#xE8F8;" Click="OnExcludedClick" />

        <TextBlock Text="Startup and data" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <controls:SettingsCard Header="Start at login" Description="Run Comet in the background when you sign in" Glyph="&#xE7E8;">
            <ToggleSwitch x:Name="StartAtLoginToggle"
                AutomationProperties.Name="Start at login" OnContent="On" OffContent="Off" Toggled="OnStartAtLoginToggled" />
        </controls:SettingsCard>
        <controls:SettingsCard x:Name="UpdatesCard" Header="Update emoji automatically" Glyph="&#xE895;">
            <ToggleSwitch x:Name="UpdatesToggle"
                AutomationProperties.Name="Update emoji automatically" OnContent="On" OffContent="Off" Toggled="OnUpdatesToggled" />
        </controls:SettingsCard>
        <controls:SettingsCard Header="Frequently used" Description="Emoji and snippets you pick often rise to the top of the list" Glyph="&#xE81C;">
            <Button x:Name="ResetFrecencyButton"
                AutomationProperties.Name="Reset" Content="Reset">
                <Button.Flyout>
                    <Flyout x:Name="ResetFlyout" Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="12" MaxWidth="280">
                            <TextBlock Text="Forget which emoji and snippets you use most?" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="The list goes back to its default order." Style="{ThemeResource SettingsSecondaryTextStyle}" />
                            <Button Content="Reset" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" Click="OnResetConfirmed" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
