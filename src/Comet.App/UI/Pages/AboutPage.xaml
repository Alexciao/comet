<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Comet.App.UI.Controls"
    Loaded="OnLoaded">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <Border
            Padding="20"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/Comet.png" Width="64" Height="64" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Comet" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Emoji, snippets and auto-replace in any app." Style="{StaticResource SettingsSecondaryTextStyle}" />
                    <TextBlock x:Name="VersionText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Emoji data" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <controls:SettingsCard x:Name="DataCard" Header="Emoji data" Glyph="&#xE76E;" />

        <TextBlock Text="Your files" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <controls:SettingsLinkCard
            x:Name="DataFolderCard"
            Header="Settings, snippets and replacements"
            Glyph="&#xE8B7;"
            ActionGlyph="&#xE8A7;"
            Click="OnOpenDataFolder" />
        <controls:SettingsLinkCard
            x:Name="LogFolderCard"
            Header="Logs"
            Description="Events and timings only, never what you type"
            Glyph="&#xE9F9;"
            ActionGlyph="&#xE8A7;"
            Click="OnOpenLogFolder" />

        <TextBlock Text="Credits" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <TextBlock Style="{StaticResource SettingsSecondaryTextStyle}" Margin="1,0,0,0">
            Emoji names, keywords and shortcodes come from emojibase, gemoji and emojilib (MIT licensed), and popularity from the Unicode Consortium's emoji frequency data.
        </TextBlock>
    </StackPanel>
</UserControl>
