<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Pages.ExcludedAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <TextBlock Text="Excluded apps" Style="{StaticResource SettingsPageTitleStyle}" />
        <TextBlock
            Text="Comet stays out of these apps. Apps with their own emoji picker are excluded from the : list by default."
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Emoji and snippets" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <StackPanel x:Name="PickerList" Spacing="{StaticResource SettingsCardSpacing}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <ComboBox x:Name="PickerAppBox" IsEditable="True" PlaceholderText="Pick a running app or type its name" MinWidth="320" DropDownOpened="OnAppBoxOpened" />
            <Button Content="Add" Click="OnAddPicker" />
        </StackPanel>

        <TextBlock Text="Auto-replace" Style="{StaticResource SettingsSectionHeaderStyle}" />
        <StackPanel x:Name="AutoReplaceList" Spacing="{StaticResource SettingsCardSpacing}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <ComboBox x:Name="AutoReplaceAppBox" IsEditable="True" PlaceholderText="Pick a running app or type its name" MinWidth="320" DropDownOpened="OnAppBoxOpened" />
            <Button Content="Add" Click="OnAddAutoReplace" />
        </StackPanel>
    </StackPanel>
</UserControl>
