<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Pages.ExcludedAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <TextBlock
            Text="Comet stays out of these apps. Apps with their own emoji picker, like Slack and Discord, are excluded from the : list to begin with."
            Style="{StaticResource SettingsSecondaryTextStyle}"
            Margin="1,0,0,16" />

        <Expander x:Name="PickerExpander" AutomationProperties.Name="Excluded from emoji and snippets" Style="{StaticResource SettingsExpanderStyle}" IsExpanded="True">
            <Expander.Header>
                <Grid ColumnSpacing="18" Padding="2,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76E;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Emoji and snippets" Style="{ThemeResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="PickerSummary" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Expander.Header>
            <StackPanel>
                <StackPanel x:Name="PickerList" />
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10,12,10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="PickerAppBox"
                            PlaceholderText="Add an app: pick one that's open, or type its name"
                            AutomationProperties.Name="App to exclude from emoji and snippets"
                            TextChanged="OnAppBoxTextChanged"
                            GotFocus="OnAppBoxGotFocus"
                            QuerySubmitted="OnPickerQuerySubmitted" />
                        <Button Grid.Column="1" Content="Add" Click="OnAddPicker" />
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>

        <Expander x:Name="AutoReplaceExpander" AutomationProperties.Name="Excluded from auto-replace" Style="{StaticResource SettingsExpanderStyle}" IsExpanded="True">
            <Expander.Header>
                <Grid ColumnSpacing="18" Padding="2,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8AC;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Auto-replace" Style="{ThemeResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="AutoReplaceSummary" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Expander.Header>
            <StackPanel>
                <StackPanel x:Name="AutoReplaceList" />
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10,12,10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="AutoReplaceAppBox"
                            PlaceholderText="Add an app: pick one that's open, or type its name"
                            AutomationProperties.Name="App to exclude from auto-replace"
                            TextChanged="OnAppBoxTextChanged"
                            GotFocus="OnAppBoxGotFocus"
                            QuerySubmitted="OnAutoReplaceQuerySubmitted" />
                        <Button Grid.Column="1" Content="Add" Click="OnAddAutoReplace" />
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
