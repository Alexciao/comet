<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Pages.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Comet.App.UI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard Header="Use snippets" Description="Show your snippets in the : list, next to emoji" Glyph="&#xE8C8;">
            <ToggleSwitch x:Name="FeatureToggle" AutomationProperties.Name="Use snippets" OnContent="On" OffContent="Off" Toggled="OnFeatureToggled" />
        </controls:SettingsCard>

        <InfoBar x:Name="StatusBar" IsClosable="True" IsOpen="False" Margin="0,8,0,0">
            <InfoBar.ActionButton>
                <Button x:Name="UndoButton" Content="Undo" Click="OnUndo" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Margin="0,22,0,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="1,0,0,0" />
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="240"
                PlaceholderText="Search snippets"
                QueryIcon="Find"
                AutomationProperties.Name="Search snippets"
                TextChanged="OnSearchChanged" />
            <Button x:Name="AddButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnAdd" AutomationProperties.Name="Add snippet">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add snippet" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" ToolTipService.ToolTip="Import and export" AutomationProperties.Name="Import and export">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Import from a file…" Click="OnImport">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExportItem" Text="Export to a file…" Click="OnExport">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE1;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel x:Name="ListPanel" Spacing="{StaticResource SettingsCardSpacing}" />

        <TextBlock x:Name="NoMatches" Text="No snippets match your search." Visibility="Collapsed" Margin="1,8,0,0" Style="{StaticResource SettingsSecondaryTextStyle}" />

        <StackPanel x:Name="EmptyState" Spacing="10" Margin="0,40,0,0" HorizontalAlignment="Center" MaxWidth="460" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8C8;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,6" />
            <TextBlock Text="Save text once, insert it anywhere" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock
                Text="Give some text a name, like website for your web address. Then type :website in any app and pick it from the list. Snippets can also insert today's date, the clipboard and more."
                TextAlignment="Center"
                Style="{StaticResource SettingsSecondaryTextStyle}" />
            <Button Content="Add your first snippet" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnAdd" />
        </StackPanel>
    </StackPanel>
</UserControl>
