<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Pages.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Comet.App.UI.Controls">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <TextBlock Text="Snippets" Style="{StaticResource SettingsPageTitleStyle}" />

        <controls:SettingsCard Header="Snippets" Description="Show your snippets in the : list, next to emoji" Glyph="&#xE8C8;">
            <ToggleSwitch x:Name="FeatureToggle" OnContent="On" OffContent="Off" Toggled="OnFeatureToggled" />
        </controls:SettingsCard>

        <InfoBar x:Name="StatusBar" IsClosable="True" IsOpen="False" Margin="0,8,0,0">
            <InfoBar.ActionButton>
                <Button x:Name="UndoButton" Content="Undo" Click="OnUndo" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Margin="0,24,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search snippets" QueryIcon="Find" MaxWidth="360" HorizontalAlignment="Left" TextChanged="OnSearchChanged" />
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAdd">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add snippet" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Import…" Click="OnImport">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExportItem" Text="Export…" Click="OnExport">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE1;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel x:Name="ListPanel" Spacing="{StaticResource SettingsCardSpacing}" />

        <TextBlock x:Name="NoMatches" Text="No snippets match your search." Visibility="Collapsed" Margin="0,12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel x:Name="EmptyState" Spacing="12" Margin="0,48,0,0" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8C8;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Save text once, insert it anywhere" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock
                Text="A snippet has a name and some text, like website → your web address. Type : and the name in any app, then pick it from the list to insert the text. Snippets can include today's date, the clipboard and more."
                TextWrapping="Wrap"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Add your first snippet" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnAdd" />
        </StackPanel>
    </StackPanel>
</UserControl>
