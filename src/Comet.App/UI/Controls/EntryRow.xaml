<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Controls.EntryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- One snippet or replacement in a list: a settings card with row actions on the right. -->
    <Border
        MinHeight="64"
        Padding="16,8,8,8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="LeadingIcon" FontSize="20" Margin="2,0,14,0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="SubtitleText"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <FontIcon
                x:Name="WarningIcon"
                Grid.Column="2"
                Glyph="&#xE7BA;"
                FontSize="16"
                Margin="8,0,8,0"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <ToggleSwitch
                x:Name="EnabledSwitch"
                Grid.Column="3"
                MinWidth="0"
                Margin="8,0,4,0"
                OnContent=""
                OffContent=""
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Toggled="OnSwitchToggled" />

            <Button
                x:Name="EditButton"
                Grid.Column="4"
                Style="{StaticResource SubtleIconButtonStyle}"
                Click="OnEditClick">
                <FontIcon Glyph="&#xE70F;" FontSize="16" />
            </Button>

            <Button x:Name="MoreButton" Grid.Column="5" Style="{StaticResource SubtleIconButtonStyle}">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Edit" Click="OnEditClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Duplicate" Click="OnDuplicateClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Click="OnDeleteClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Border>
</UserControl>
