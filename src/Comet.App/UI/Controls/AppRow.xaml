<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Controls.AppRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- One excluded app inside an expander, aligned with the expander's header text as in Windows Settings. -->
    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,6,12,6">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xECAA;" FontSize="16" Margin="4,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="NameText" Grid.Column="1" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" Click="OnRemoveClick" />
        </Grid>
    </Border>
</UserControl>
