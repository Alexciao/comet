<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The few layout values Settings needs, in one place. Everything else (colors, fonts, card metrics) is the
        Community Toolkit's and WinUI's defaults. Code never looks resources up: in the Native AOT build a cast of a
        looked-up resource fails.
    -->

    <!-- The window's title bar, as tall as Windows Settings' (which holds its search box). -->
    <x:Double x:Key="SettingsTitleBarHeight">48</x:Double>

    <!-- The navigation pane, measured against Windows Settings at the same window size: the content column starts
         at the same x, the app card sits where the account card does, and the first item at the same height. -->
    <x:Double x:Key="SettingsPaneLength">311</x:Double>
    <Thickness x:Key="SettingsPaneHeaderPadding">16,8,16,34</Thickness>
    <x:Double x:Key="SettingsPaneIconSize">48</x:Double>

    <!-- Between cards, as in Windows Settings. -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <!-- The content column: left-aligned, at most 1000 wide; the page title lines up with it. -->
    <x:Double x:Key="SettingsContentMaxWidth">1000</x:Double>
    <Thickness x:Key="SettingsPagePadding">16,0,24,32</Thickness>
    <Thickness x:Key="SettingsPageTitleMargin">12,6,24,20</Thickness>
    <Thickness x:Key="SettingsStatusPadding">16,0,24,0</Thickness>

    <Style x:Key="SettingsSectionHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,30,0,6" />
    </Style>

    <Style x:Key="SettingsPageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="{StaticResource SettingsPageTitleMargin}" />
    </Style>

    <!-- Add/Edit dialogs: wider than the ContentDialog default, as in Windows Settings. -->
    <x:Double x:Key="SettingsDialogWidth">640</x:Double>
    <x:Double x:Key="SettingsDialogContentWidth">592</x:Double>

    <!-- Dialog fields and the validation line under each. -->
    <Thickness x:Key="SettingsFieldMessageMargin">0,4,0,0</Thickness>
    <Thickness x:Key="SettingsFieldHeaderMargin">0,0,0,8</Thickness>
    <x:Double x:Key="SettingsDialogFieldSpacing">16</x:Double>
    <!-- The snippet text box: about six lines, then it scrolls. -->
    <x:Double x:Key="SettingsSnippetTextHeight">136</x:Double>
    <Thickness x:Key="SettingsPreviewPadding">12,8,12,8</Thickness>
    <x:Double x:Key="SettingsPreviewMaxHeight">120</x:Double>
    <!-- The "Add app" dialog's list of running apps. -->
    <x:Double x:Key="SettingsAppListHeight">300</x:Double>
    <x:Double x:Key="SettingsAppIconSize">20</x:Double>
    <Thickness x:Key="SettingsAppRowPadding">0,6,0,6</Thickness>

    <!-- Snippets and Auto-replace: the search row above the list, spaced like a section header. -->
    <Thickness x:Key="SettingsListToolbarMargin">0,26,0,4</Thickness>
    <x:Double x:Key="SettingsSearchBoxWidth">360</x:Double>
    <!-- Cards the lists realize beyond the visible ones, in viewports (ItemsRepeater default: 2). -->
    <x:Double x:Key="SettingsListCacheLength">0.5</x:Double>
    <x:Double x:Key="SettingsToolbarSpacing">12</x:Double>
    <!-- The empty-list message and its button. -->
    <Thickness x:Key="SettingsEmptyStatePadding">0,32,0,32</Thickness>
</ResourceDictionary>
