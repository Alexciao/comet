<local:SettingsPage
    x:Class="Comet.App.UI.Settings.Pages.EmojiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Comet.App.UI.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SettingsPageTitleTextBlockStyle}" Text="Emoji" />

        <ScrollViewer Grid.Row="1">
            <Grid Padding="{StaticResource SettingsPagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <toolkit:SettingsCard Header="Emoji" Description="Type : and a few letters in any app to pick an emoji">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE76E;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch OffContent="Off" OnContent="On" x:Name="FeatureToggle" AutomationProperties.Name="Emoji" Toggled="OnFeatureToggled" />
                    </toolkit:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Emoji picker" />
                    <toolkit:SettingsCard Header="Default skin tone" Description="Used for emoji that come in more than one skin tone">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="SkinToneBox" AutomationProperties.Name="Default skin tone" SelectionChanged="OnSkinToneChanged">
                            <ComboBoxItem Content="✋  Default" />
                            <ComboBoxItem Content="✋🏻  Light" />
                            <ComboBoxItem Content="✋🏼  Medium-light" />
                            <ComboBoxItem Content="✋🏽  Medium" />
                            <ComboBoxItem Content="✋🏾  Medium-dark" />
                            <ComboBoxItem Content="✋🏿  Dark" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Clear recently used" Description="The : menu forgets which emoji and snippets you picked most and goes back to its usual order">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button x:Name="ClearButton" Click="OnClearRecent" Content="Clear" />
                    </toolkit:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:SettingsPage>
