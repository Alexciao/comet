<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Comet.App.UI.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Comet">
    <!-- Eight rows created once in code and refilled in place: a virtualized window over the results. -->
    <Grid x:Name="Root" PointerWheelChanged="OnPointerWheel">
        <!-- Offscreen stage where emoji bitmaps are rendered (see EmojiBitmapCache). -->
        <Canvas x:Name="Stage" IsHitTestVisible="False" />
        <StackPanel x:Name="RowsPanel" Padding="4" />
        <!-- Shows where the visible rows sit in a longer list, like the collapsed Windows 11 scroll bar. -->
        <Rectangle
            x:Name="ScrollThumb"
            Width="2"
            RadiusX="1"
            RadiusY="1"
            Margin="0,0,2,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
            Visibility="Collapsed" />
    </Grid>
</Window>
