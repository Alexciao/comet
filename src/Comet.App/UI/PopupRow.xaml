<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.PopupRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="36"
    IsTabStop="False">
    <!-- A Windows 11 list item: subtle fill for hover/selection and an accent pill marking the selection. -->
    <Grid x:Name="RowRoot" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <!-- Same fills as the WinUI ListViewItem; no transitions, so selection changes are instant. -->
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        <Setter Target="Pill.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPointerOver">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                        <Setter Target="Pill.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="Fill" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Rectangle
            x:Name="Pill"
            Width="3"
            Height="16"
            RadiusX="1.5"
            RadiusY="1.5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="{ThemeResource AccentFillColorDefaultBrush}"
            Visibility="Collapsed" />
        <Grid Margin="10,0,12,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="EmojiImage" Width="28" Height="28" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmojiText"
                FontFamily="Segoe UI Emoji"
                FontSize="20"
                IsColorFontEnabled="True"
                IsTextScaleFactorEnabled="False"
                TextAlignment="Center"
                VerticalAlignment="Center" />
            <FontIcon
                x:Name="SnippetIcon"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Glyph="&#xE70B;"
                FontSize="16"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyTextBlockStyle}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                MaxLines="1">
                <Run x:Name="BeforeRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run x:Name="MatchRun" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /><Run x:Name="AfterRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run x:Name="PreviewRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
