<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comet.App.UI.Dialogs.ValidationRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- One validation message under a form field: the Windows 11 critical or caution icon, then the text. -->
    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
            x:Name="ErrorIcon"
            Glyph="&#xEB90;"
            FontSize="14"
            Margin="0,2,0,0"
            VerticalAlignment="Top"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <FontIcon
            x:Name="WarningIcon"
            Glyph="&#xE7BA;"
            FontSize="14"
            Margin="0,2,0,0"
            VerticalAlignment="Top"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Visibility="Collapsed" />
        <TextBlock x:Name="MessageText" Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
