<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 plumbing with no UI dependency: keyboard hook, key translation, focus context, caret, text insertion. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Inlay.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inlay.Core\Inlay.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Inlay" />
    <InternalsVisibleTo Include="Inlay.Platform.Tests" />
  </ItemGroup>
</Project>
