<local:SettingsPage
    x:Class="Inlay.App.UI.Settings.Pages.QuickInsertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inlay.App.UI.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SettingsPageTitleTextBlockStyle}" Text="Quick Insert" />

        <ScrollViewer Grid.Row="1">
            <Grid Padding="{StaticResource SettingsPagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <!-- Quick Insert has no switch of its own: it is on while one of its sources is. -->
                    <InfoBar x:Name="AllOffBar" x:Load="False" IsClosable="False" IsOpen="True" Severity="Warning" Title="Quick Insert is off">
                        <InfoBar.Content>
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
                                <Run Text="Turn on" />
                                <Hyperlink Click="OnOpenSnippets">Snippets</Hyperlink><Run Text="," />
                                <Hyperlink Click="OnOpenImages">Images</Hyperlink>
                                <Run Text="or" />
                                <Hyperlink Click="OnOpenEmoji">Emoji</Hyperlink>
                                <Run Text="to use it" />
                            </TextBlock>
                        </InfoBar.Content>
                    </InfoBar>

                    <toolkit:SettingsCard x:Name="TriggerCard" Header="Trigger character">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE765;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="TriggerBox"
                            AutomationProperties.Name="Trigger character"
                            KeyDown="OnTriggerKeyDown"
                            LostFocus="OnTriggerLostFocus"
                            MaxLength="1"
                            TextAlignment="Center" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Minimum characters" Description="Letters to type after the trigger before Quick Insert opens">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8E9;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <NumberBox
                            x:Name="MinCharsBox"
                            AutomationProperties.Name="Minimum characters"
                            Maximum="4"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnMinCharsChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="ShortcutCard" Header="Keyboard shortcut">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE92E;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <local:ShortcutRecorder x:Name="ShortcutRecorder" DialogTitle="Keyboard shortcut" ShortcutChanged="OnShortcutChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsExpander x:Name="RecentsExpander" Header="Show recent items when you pause after the trigger" Description="Quick Insert opens with the items you use most">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch OffContent="Off" OnContent="On" x:Name="RecentsToggle" AutomationProperties.Name="Show recent items when you pause after the trigger" Toggled="OnRecentsToggled" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="DelayCard" Header="Pause length">
                                <Slider
                                    x:Name="DelaySlider"
                                    MinWidth="200"
                                    AutomationProperties.Name="Pause length in milliseconds"
                                    Maximum="1500"
                                    Minimum="300"
                                    SmallChange="100"
                                    StepFrequency="100"
                                    TickFrequency="300"
                                    TickPlacement="Outside"
                                    ValueChanged="OnDelayChanged" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                    <toolkit:SettingsCard Header="Clear recent items" Description="Forget what you picked, so results go back to their usual order">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74D;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button x:Name="ClearButton" Click="OnClearRecent" Content="Clear" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="CreateCard" Header="Offer to create a snippet when nothing matches">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch OffContent="Off" OnContent="On" x:Name="CreateToggle" AutomationProperties.Name="Offer to create a snippet when nothing matches" Toggled="OnCreateToggled" />
                    </toolkit:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Apps" />
                    <local:AppModesExpander x:Name="AppModes" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:SettingsPage>
