<local:SettingsPage
    x:Class="Inlay.App.UI.Settings.Pages.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Inlay.App.UI.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="SnippetTemplate" x:DataType="local:SnippetItem">
            <toolkit:SettingsCard
                AutomationProperties.Name="{x:Bind AccessibleName}"
                Click="{x:Bind Open}"
                Header="{x:Bind Name}"
                IsActionIconVisible="False"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE70B;" />
                </toolkit:SettingsCard.HeaderIcon>
                <!-- One line, trimmed, as in Installed apps (and cheaper to lay out than wrapped text). -->
                <toolkit:SettingsCard.Description>
                    <TextBlock MaxLines="1" Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" />
                </toolkit:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SettingsToolbarSpacing}">
                    <FontIcon
                        x:Name="WarningIcon"
                        x:Load="{x:Bind HasWarning}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;"
                        ToolTipService.ToolTip="A placeholder isn't written correctly and will be inserted as typed" />
                    <Button
                        AutomationProperties.Name="{x:Bind MoreOptionsName}"
                        Click="{x:Bind ShowMenu}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="More options">
                        <FontIcon Glyph="&#xE712;" />
                    </Button>
                </StackPanel>
            </toolkit:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SettingsPageTitleTextBlockStyle}" Text="Snippets" />

        <!-- Above the list, not in it: an Undo must be visible wherever the list is scrolled. -->
        <Grid Grid.Row="1" Padding="{StaticResource SettingsStatusPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="StatusBar" x:Load="False" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="UndoButton" Click="OnUndo" Content="Undo" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="2">
            <Grid Padding="{StaticResource SettingsPagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                    <toolkit:SettingsCard Header="Snippets" Description="Insert text you use often from Quick Insert">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE70B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch OffContent="Off" OnContent="On" x:Name="FeatureToggle" AutomationProperties.Name="Snippets" Toggled="OnFeatureToggled" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Name="AddCard" Header="Add a snippet" Description="Give it a short name, then type : and the name in any app">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button Click="OnAdd" Content="Add snippet" Style="{StaticResource AccentButtonStyle}" />
                    </toolkit:SettingsCard>

                    <Grid Margin="{StaticResource SettingsListToolbarMargin}" ColumnSpacing="{StaticResource SettingsToolbarSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsSearchBoxWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="SearchBox"

                            AutomationProperties.Name="Search snippets"
                            PlaceholderText="Search snippets"
                            QueryIcon="Find"
                            TextChanged="OnSearchChanged" />
                        <TextBlock
                            x:Name="CountText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="More options"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="More options">
                            <FontIcon Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Click="OnImport" Text="Import…">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="ExportAllItem" Click="OnExportAll" Text="Export all…">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEDE1;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ItemsRepeater x:Name="List" VerticalCacheLength="{StaticResource SettingsListCacheLength}" ItemTemplate="{StaticResource SnippetTemplate}" ItemsSource="{x:Bind Items}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <TextBlock
                        x:Name="NoMatches"
                        x:Load="False"
                        Padding="{StaticResource SettingsEmptyStatePadding}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No snippets match your search" />

                    <StackPanel
                        x:Name="EmptyState"
                        x:Load="False"
                        Padding="{StaticResource SettingsEmptyStatePadding}"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SettingsToolbarSpacing}">
                        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Snippets you add appear here" />
                        <Button HorizontalAlignment="Center" Click="OnAdd" Content="Add snippet" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:SettingsPage>
