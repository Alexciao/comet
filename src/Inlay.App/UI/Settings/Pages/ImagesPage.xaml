<local:SettingsPage
    x:Class="Inlay.App.UI.Settings.Pages.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:images="using:Inlay.App.UI.Settings.Images"
    xmlns:local="using:Inlay.App.UI.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--
            Tiles as in Settings › Personalization › Background: a fixed size (thumbnails fill in without moving
            anything), the picture in a rounded frame, the code and a caption under it.
        -->
        <x:Double x:Key="ImageTileWidth">160</x:Double>
        <x:Double x:Key="ImageTileHeight">168</x:Double>
        <x:Double x:Key="ImageTileThumbnailWidth">150</x:Double>
        <x:Double x:Key="ImageTileThumbnailHeight">110</x:Double>
        <x:Double x:Key="ImageTileSpacing">8</x:Double>
        <Thickness x:Key="ImageTilePadding">5,5,5,4</Thickness>
        <Thickness x:Key="ImageTileTextMargin">2,7,26,0</Thickness>
        <Thickness x:Key="ImageTileCaptionMargin">2,0,26,0</Thickness>
        <Thickness x:Key="ImageTileBadgeMargin">6</Thickness>
        <Thickness x:Key="ImageTileBadgePadding">7,4,7,4</Thickness>
        <Thickness x:Key="ImageTileMoreMargin">0,0,3,6</Thickness>
        <CornerRadius x:Key="ImageTileBadgeCornerRadius">10</CornerRadius>
        <x:Double x:Key="ImageTileMoreSize">28</x:Double>
        <x:Double x:Key="ImageTileBadgeIconSize">12</x:Double>
        <x:Double x:Key="ImageTilePlaceholderIconSize">28</x:Double>
        <x:Double x:Key="ImageTileMoreIconSize">14</x:Double>

        <DataTemplate x:Key="TileTemplate" x:DataType="images:ImageTileItem">
            <Grid Width="{StaticResource ImageTileWidth}" Height="{StaticResource ImageTileHeight}">
                <Button
                    Padding="{StaticResource ImageTilePadding}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    AutomationProperties.Name="{x:Bind AccessibleName}"
                    Click="{x:Bind Open}"
                    ContextRequested="{x:Bind OnContextRequested}"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel>
                        <Border
                            Width="{StaticResource ImageTileThumbnailWidth}"
                            Height="{StaticResource ImageTileThumbnailHeight}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid>
                                <FontIcon
                                    FontSize="{StaticResource ImageTilePlaceholderIconSize}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="{x:Bind PlaceholderGlyph}"
                                    Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}" />
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                <Border
                                    Margin="{StaticResource ImageTileBadgeMargin}"
                                    Padding="{StaticResource ImageTileBadgePadding}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ImageTileBadgeCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind BadgeName}"
                                    Visibility="{x:Bind HasBadge}">
                                    <FontIcon FontSize="{StaticResource ImageTileBadgeIconSize}" Glyph="{x:Bind BadgeGlyph}" />
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock
                            Margin="{StaticResource ImageTileTextMargin}"
                            MaxLines="1"
                            Text="{x:Bind Code}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="{StaticResource ImageTileCaptionMargin}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Caption}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <!-- Beside the text, not over the picture; keyboard users open the same menu with Shift+F10. -->
                <Button
                    Width="{StaticResource ImageTileMoreSize}"
                    Height="{StaticResource ImageTileMoreSize}"
                    Margin="{StaticResource ImageTileMoreMargin}"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="{x:Bind MoreOptionsName}"
                    Click="{x:Bind ShowMenu}"
                    IsTabStop="False"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="More options">
                    <FontIcon FontSize="{StaticResource ImageTileMoreIconSize}" Glyph="&#xE712;" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Image files dropped anywhere on the page are added (the background makes the empty space a drop target). -->
    <Grid AllowDrop="True" Background="Transparent" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SettingsPageTitleTextBlockStyle}" Text="Images" />

        <!-- Above the tiles, not among them: an Undo must be visible wherever the page is scrolled. -->
        <Grid Grid.Row="1" Padding="{StaticResource SettingsStatusPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="StatusBar" x:Load="False" Closed="OnStatusClosed" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="UndoButton" Click="OnUndo" Content="Undo" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="2">
            <Grid Padding="{StaticResource SettingsPagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                    <toolkit:SettingsCard Header="Images" Description="Insert your own images and GIFs from Quick Insert">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEB9F;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="FeatureToggle" AutomationProperties.Name="Images" OffContent="Off" OnContent="On" Toggled="OnFeatureToggled" />
                    </toolkit:SettingsCard>

                    <Grid Margin="{StaticResource SettingsListToolbarMargin}" ColumnSpacing="{StaticResource SettingsToolbarSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsSearchBoxWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SplitButton AutomationProperties.Name="Add image" Click="OnAddImageSplit" Content="Add image…">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Click="OnAddFolder" Text="Add folder…">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnAddCollection" Text="Add collection…">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8F1;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnAddScreenshot" Text="Add latest screenshot">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7F4;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            AutomationProperties.Name="Search images"
                            PlaceholderText="Search images"
                            QueryIcon="Find"
                            TextChanged="OnSearchChanged" />
                        <TextBlock
                            x:Name="CountText"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ItemsRepeater
                        x:Name="Tiles"
                        ElementClearing="OnTileClearing"
                        ElementPrepared="OnTilePrepared"
                        ItemTemplate="{StaticResource TileTemplate}"
                        ItemsSource="{x:Bind Items}"
                        TabFocusNavigation="Once"
                        VerticalCacheLength="{StaticResource SettingsListCacheLength}"
                        XYFocusKeyboardNavigation="Enabled">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsJustification="Start"
                                ItemsStretch="None"
                                MinColumnSpacing="{StaticResource ImageTileSpacing}"
                                MinItemHeight="{StaticResource ImageTileHeight}"
                                MinItemWidth="{StaticResource ImageTileWidth}"
                                MinRowSpacing="{StaticResource ImageTileSpacing}" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <TextBlock
                        x:Name="NoMatches"
                        x:Load="False"
                        Padding="{StaticResource SettingsEmptyStatePadding}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No images match your search." />

                    <StackPanel
                        x:Name="EmptyState"
                        x:Load="False"
                        Padding="{StaticResource SettingsEmptyStatePadding}"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SettingsToolbarSpacing}">
                        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Drop image files here, or press Ctrl+V to paste an image." />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource SettingsToolbarSpacing}">
                            <Button Click="OnAddImage" Content="Add image…" Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OnAddScreenshot" Content="Add latest screenshot" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:SettingsPage>
