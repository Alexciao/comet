<ContentDialog
    x:Class="Inlay.App.UI.Settings.Dialogs.SnippetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <StaticResource x:Key="ContentDialogMaxWidth" ResourceKey="SettingsDialogWidth" />
    </ContentDialog.Resources>

    <StackPanel Width="{StaticResource SettingsDialogContentWidth}" Spacing="{StaticResource SettingsDialogFieldSpacing}">
        <StackPanel>
            <TextBox
                x:Name="NameBox"
                AutomationProperties.Name="Name"
                Header="Name"
                TextChanged="OnChanged" />
            <TextBlock x:Name="NameError" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="NameWarning" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel>
            <TextBox
                x:Name="TextBox"
                Height="{StaticResource SettingsSnippetTextHeight}"
                AcceptsReturn="True"
                AutomationProperties.Name="Text"
                Header="Text"

                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="OnChanged"
                TextWrapping="Wrap" />
            <TextBlock x:Name="TextError" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="TextWarning" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <DropDownButton Margin="{StaticResource SettingsFieldMessageMargin}" Content="Insert placeholder">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="PlaceholderMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="{StaticResource SettingsFieldHeaderMargin}" Text="Preview" />
            <Border
                Padding="{StaticResource SettingsPreviewPadding}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <ScrollViewer MaxHeight="{StaticResource SettingsPreviewMaxHeight}">
                    <Grid>
                        <TextBlock x:Name="PreviewText" AutomationProperties.Name="Preview" IsTextSelectionEnabled="True" TextWrapping="Wrap">
                            <Run x:Name="BeforeCaret" /><Run x:Name="Caret" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run x:Name="AfterCaret" />
                        </TextBlock>
                        <TextBlock
                            x:Name="PreviewHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Shows what the snippet inserts, with dates and the clipboard filled in"
                            TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>
