<ContentDialog
    x:Class="Inlay.App.UI.Settings.Dialogs.ShortcutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <!-- Key caps as in PowerToys' shortcut dialog: accent when the combination can be saved, neutral while it is
             incomplete or not allowed. -->
        <x:Double x:Key="ShortcutKeyMinWidth">56</x:Double>
        <x:Double x:Key="ShortcutKeyMinHeight">48</x:Double>
        <x:Double x:Key="ShortcutKeySpacing">8</x:Double>
        <x:Double x:Key="ShortcutAreaHeight">112</x:Double>
        <x:Double x:Key="ShortcutDialogContentWidth">440</x:Double>
        <Thickness x:Key="ShortcutKeyPadding">16,8,16,8</Thickness>

        <DataTemplate x:Key="AccentKeyTemplate" x:DataType="x:String">
            <Border
                MinWidth="{StaticResource ShortcutKeyMinWidth}"
                MinHeight="{StaticResource ShortcutKeyMinHeight}"
                Padding="{StaticResource ShortcutKeyPadding}"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlainKeyTemplate" x:DataType="x:String">
            <Border
                MinWidth="{StaticResource ShortcutKeyMinWidth}"
                MinHeight="{StaticResource ShortcutKeyMinHeight}"
                Padding="{StaticResource ShortcutKeyPadding}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind}" />
            </Border>
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Width="{StaticResource ShortcutDialogContentWidth}" Spacing="{StaticResource SettingsToolbarSpacing}">
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Press a combination of keys to change this shortcut" TextWrapping="Wrap" />

        <Border
            Height="{StaticResource ShortcutAreaHeight}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid x:Name="KeysArea" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                <ItemsRepeater x:Name="AccentKeys" ItemTemplate="{StaticResource AccentKeyTemplate}" ItemsSource="{x:Bind Keys}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="{StaticResource ShortcutKeySpacing}" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <ItemsRepeater x:Name="PlainKeys" ItemTemplate="{StaticResource PlainKeyTemplate}" ItemsSource="{x:Bind Keys}" Visibility="Collapsed">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="{StaticResource ShortcutKeySpacing}" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock x:Name="OffText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource SubtitleTextBlockStyle}" Text="No shortcut" Visibility="Collapsed" />
            </Grid>
        </Border>

        <StackPanel>
            <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="HintText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShortcutKeySpacing}">
            <Button x:Name="ResetButton" Click="OnReset" Content="Reset" />
            <Button x:Name="ClearButton" Click="OnClear" Content="Clear" ToolTipService.ToolTip="Turn the shortcut off" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
