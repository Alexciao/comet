<ContentDialog
    x:Class="Inlay.App.UI.Settings.Dialogs.ImageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <StaticResource x:Key="ContentDialogMaxWidth" ResourceKey="SettingsDialogWidth" />
        <!-- The preview: as wide as the fields, a fixed height so nothing moves when the picture arrives. -->
        <x:Double x:Key="ImagePreviewHeight">180</x:Double>
        <!-- The collection's names: a few lines, then it scrolls. -->
        <x:Double x:Key="ImageNamesMaxHeight">112</x:Double>
        <x:Double x:Key="ImageFileTypeSpacing">20</x:Double>
        <x:Double x:Key="ImagePickCountWidth">120</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="{StaticResource SettingsDialogContentWidth}" Spacing="{StaticResource SettingsDialogFieldSpacing}">

        <!-- Images and folders: what the code inserts. -->
        <StackPanel x:Name="PreviewSection">
            <Border
                x:Name="PreviewFrame"
                Height="{StaticResource ImagePreviewHeight}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid>
                    <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon x:Name="PreviewPlaceholderIcon" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE91B;" />
                        <TextBlock
                            x:Name="PreviewMessage"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Image x:Name="PreviewImage" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Preview" Stretch="Uniform" />
                </Grid>
            </Border>
            <TextBlock
                x:Name="PreviewCaption"
                Margin="{StaticResource SettingsFieldMessageMargin}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FileError" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="FileWarning" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="NameSection">
            <TextBox
                x:Name="NameBox"
                AutomationProperties.Name="Name"
                Header="Name"
                PlaceholderText="For example, lgtm"
                TextChanged="OnNameChanged" />
            <TextBlock x:Name="NameHint" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="NameError" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="NameWarning" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <!-- Folders and collections. -->
        <StackPanel x:Name="FolderSection">
            <TextBlock Margin="{StaticResource SettingsFieldHeaderMargin}" Text="Folder" />
            <DropDownButton
                x:Name="FolderButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="Folder">
                <TextBlock x:Name="FolderText" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="FolderMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock x:Name="FolderError" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="FolderWarning" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <CheckBox x:Name="SubfoldersBox" Margin="{StaticResource SettingsFieldMessageMargin}" Click="OnFolderOptionChanged" Content="Include subfolders" />
        </StackPanel>

        <!-- Folders: which image the code inserts. -->
        <StackPanel x:Name="ModeSection">
            <Grid ColumnSpacing="{StaticResource SettingsToolbarSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="ModeBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Mode"
                    Header="Mode"
                    SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="Latest" />
                    <ComboBoxItem Content="Random" />
                    <ComboBoxItem Content="Let me pick" />
                </ComboBox>
                <NumberBox
                    x:Name="PickCountBox"
                    Grid.Column="1"
                    Width="{StaticResource ImagePickCountWidth}"
                    AutomationProperties.Name="Number to pick"
                    Header="Number to pick"
                    Maximum="8"
                    Minimum="2"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="OnPickCountChanged" />
            </Grid>
            <TextBlock
                x:Name="ModeHint"
                Margin="{StaticResource SettingsFieldMessageMargin}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="TypesSection">
            <TextBlock Margin="{StaticResource SettingsFieldHeaderMargin}" Text="File types" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ImageFileTypeSpacing}">
                <CheckBox x:Name="PngBox" MinWidth="0" Click="OnFolderOptionChanged" Content="PNG" />
                <CheckBox x:Name="JpgBox" MinWidth="0" Click="OnFolderOptionChanged" Content="JPG" />
                <CheckBox x:Name="GifBox" MinWidth="0" Click="OnFolderOptionChanged" Content="GIF" />
                <CheckBox x:Name="WebpBox" MinWidth="0" Click="OnFolderOptionChanged" Content="WebP" />
                <CheckBox x:Name="BmpBox" MinWidth="0" Click="OnFolderOptionChanged" Content="BMP" />
            </StackPanel>
            <TextBlock
                x:Name="TypesError"
                Margin="{StaticResource SettingsFieldMessageMargin}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Choose at least one file type."
                Visibility="Collapsed" />
        </StackPanel>

        <!-- Collections: the prefix and the names it gives every file. -->
        <StackPanel x:Name="PrefixSection">
            <TextBox
                x:Name="PrefixBox"
                AutomationProperties.Name="Prefix"
                Header="Prefix"
                PlaceholderText="Optional, for example gif_"
                TextChanged="OnPrefixChanged" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Goes before each file's name" TextWrapping="Wrap" />
            <TextBlock x:Name="PrefixError" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="PrefixWarning" Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="NamesSection">
            <TextBlock x:Name="NamesHeader" Margin="{StaticResource SettingsFieldHeaderMargin}" Text="Names" />
            <Border
                Padding="{StaticResource SettingsPreviewPadding}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <ScrollViewer MaxHeight="{StaticResource ImageNamesMaxHeight}">
                    <Grid>
                        <TextBlock x:Name="NamesText" AutomationProperties.Name="Names" IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="NamesMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </Border>
            <TextBlock
                x:Name="NamesMore"
                Margin="{StaticResource SettingsFieldMessageMargin}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel>
            <TextBox
                x:Name="KeywordsBox"
                AutomationProperties.Name="Keywords"
                Header="Keywords"
                PlaceholderText="For example, approve ship" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Margin="{StaticResource SettingsFieldMessageMargin}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Extra words that find it in Quick Insert, separated by spaces" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel>
            <ComboBox
                x:Name="InsertAsBox"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Insert as"
                Header="Insert as"
                SelectionChanged="OnInsertAsChanged">
                <ComboBoxItem Content="Image" />
                <ComboBoxItem Content="File" />
                <ComboBoxItem Content="File path" />
            </ComboBox>
            <TextBlock
                x:Name="InsertAsHint"
                Margin="{StaticResource SettingsFieldMessageMargin}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
