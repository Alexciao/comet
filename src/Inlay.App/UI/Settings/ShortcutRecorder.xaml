<UserControl
    x:Class="Inlay.App.UI.Settings.ShortcutRecorder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Key caps in the subtle Windows 11 control style; the dialog shows them larger and in the accent color. -->
        <x:Double x:Key="ShortcutKeyMinWidth">32</x:Double>
        <x:Double x:Key="ShortcutKeySpacing">4</x:Double>
        <x:Double x:Key="ShortcutRecorderSpacing">12</x:Double>
        <Thickness x:Key="ShortcutKeyPadding">8,4,8,5</Thickness>
        <x:Double x:Key="ShortcutEditGlyphSize">14</x:Double>
    </UserControl.Resources>

    <!-- As in PowerToys: the current shortcut as key caps, then a button to change it. -->
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShortcutRecorderSpacing}">
        <ItemsRepeater x:Name="KeysView" VerticalAlignment="Center" ItemsSource="{x:Bind Keys}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" Spacing="{StaticResource ShortcutKeySpacing}" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border
                        MinWidth="{StaticResource ShortcutKeyMinWidth}"
                        Padding="{StaticResource ShortcutKeyPadding}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock HorizontalAlignment="Center" Text="{x:Bind}" />
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <TextBlock
            x:Name="OffText"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Off"
            Visibility="Collapsed" />
        <Button
            x:Name="EditButton"
            AutomationProperties.Name="Change shortcut"
            Click="OnEdit"
            ToolTipService.ToolTip="Change shortcut">
            <FontIcon FontSize="{StaticResource ShortcutEditGlyphSize}" Glyph="&#xE70F;" />
        </Button>
    </StackPanel>
</UserControl>
