<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Inlay.App.UI.QuickInsertRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="36"
    IsTabStop="False">
    <!-- A Windows 11 list item: subtle fill for hover/selection and an accent pill marking the selection. -->
    <Grid x:Name="RowRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <!-- Same fills as the WinUI ListViewItem; no transitions, so selection changes are instant. -->
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        <Setter Target="Pill.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPointerOver">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                        <Setter Target="Pill.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="Fill" Grid.RowSpan="2" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Rectangle
            x:Name="Pill"
            Width="3"
            Height="16"
            RadiusX="1.5"
            RadiusY="1.5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="{ThemeResource AccentFillColorDefaultBrush}"
            Visibility="Collapsed" />
        <Grid Margin="8,0,12,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The glyph slot: one of these is visible. -->
            <Image x:Name="EmojiImage" Width="28" Height="28" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmojiText"
                FontFamily="Segoe UI Emoji"
                FontSize="20"
                IsColorFontEnabled="True"
                IsTextScaleFactorEnabled="False"
                TextAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <!-- Symbols are text, drawn in the UI font (with Windows' font fallback), not as color emoji. -->
            <TextBlock
                x:Name="SymbolText"
                FontSize="18"
                IsColorFontEnabled="False"
                IsTextScaleFactorEnabled="False"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <FontIcon
                x:Name="GlyphIcon"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Glyph="&#xE70B;"
                FontSize="16"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <Border
                x:Name="Thumb"
                Width="32"
                Height="32"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Image x:Name="ThumbImage" Stretch="UniformToFill" />
            </Border>

            <!-- Two stacked lines that fit the row's height as a pair: the code, then a caption. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="CodeLine"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    LineHeight="18"
                    LineStackingStrategy="BlockLineHeight"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1">
                    <Run x:Name="BeforeRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run x:Name="MatchRun" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /><Run x:Name="AfterRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <TextBlock
                    x:Name="CaptionLine"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    LineHeight="15"
                    LineStackingStrategy="BlockLineHeight"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </StackPanel>

            <!-- Marks a recent item (Quick Insert opened after a pause, or from the shortcut). -->
            <FontIcon
                x:Name="HistoryIcon"
                Grid.Column="2"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Glyph="&#xE81C;"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <!-- "Let me pick": the newest images of the folder, shown only in the selected row; ←/→ choose. -->
        <StackPanel x:Name="PickStrip" Grid.Row="1" Margin="50,0,12,8" Orientation="Horizontal" Spacing="4" Visibility="Collapsed" />
    </Grid>
</UserControl>
